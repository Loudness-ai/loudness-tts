{
  "name": "loudness-tts",
  "version": "0.1.0",
  "description": "Fast, natural text to speech on your own computer, server or web page: 1,683 ranked voices, numbers and dates read as words, word timings, SRT/VTT subtitles, OpenAI-compatible server. No API key.",
  "keywords": [
    "text-to-speech",
    "tts",
    "speech-synthesis",
    "piper",
    "piper-tts",
    "offline",
    "local",
    "local-tts",
    "self-hosted",
    "voice",
    "subtitles",
    "srt",
    "vtt",
    "openai-compatible",
    "onnx",
    "webassembly",
    "browser",
    "espeak-ng",
    "text-normalization"
  ],
  "homepage": "https://loudness.ai/developers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loudness-ai/loudness-tts.git",
    "directory": "javascript"
  },
  "bugs": "https://github.com/Loudness-ai/loudness-tts/issues",
  "author": "Asad Shehzad <asad@loudness.ai> (https://loudness.ai/)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "./dist/node.js",
    "./dist/node-platform.js",
    "./dist/server.js",
    "./dist/cli.js"
  ],
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./textprep": {
      "types": "./dist/textprep.d.ts",
      "default": "./dist/textprep.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#ort": {
      "node": "onnxruntime-web",
      "default": "onnxruntime-web/wasm"
    }
  },
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "bin": {
    "loudness-tts": "dist/cli.js"
  },
  "files": [
    "dist",
    "espeak-ng-data",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/run.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
